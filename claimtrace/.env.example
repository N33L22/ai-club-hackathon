# Copy to .env.local and fill in. Never commit .env.local.
# Set the same variables in your host's settings (Vercel: Project Settings > Environment Variables).

# --- Scholarly databases (needed for search and reliable checks) -----------------
# OpenAlex: free key from https://openalex.org/settings/api (make an account, then
# Settings > API key). Without one, everyone on your network shares about $0.10 of
# requests a day (roughly 100 searches), which a demo or a busy venue uses up fast.
OPENALEX_API_KEY=
# Crossref: a contact email joins the "polite pool" (higher limits than the public
# pool's one search a second). Use a team address.
CONTACT_EMAIL=

# --- AI (Scout, Skeptic, Assistant) ---------------------------------------------
# Without a key the app still works: references are verified by code, claims show
# "Unchecked" (never "Supported"), and the demo project can show labelled samples.
NVIDIA_API_KEY=

# Any OpenAI-compatible provider works by changing these (defaults shown).
# The default model was chosen by measuring four NVIDIA-hosted setups on 20 labelled claims
# (eval/skeptic-model-comparison.md). Hosted models get retired: meta/llama-3.3-70b-instruct
# reached end of life on NVIDIA on 26 Aug 2026, so re-run `npm run eval:skeptic -- live` after a change.
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_PROVIDER_LABEL=NVIDIA NIM
# AI_TEMPERATURE=0
# Most current models think before answering. On NVIDIA's endpoint ClaimTrace switches that off by
# default ({"chat_template_kwargs":{"enable_thinking":false}}); set AI_EXTRA_BODY to override, or {} to send nothing.
# AI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# For a model that must think first, give it room (every token budget is multiplied by this):
# AI_MAX_TOKENS_SCALE=1
# AI_TIMEOUT_MS=40000

# --- Protecting the team's quota ------------------------------------------------
# AI_REQUESTS_PER_MINUTE=35              # whole server (NVIDIA free tier is ~40/min)
# AI_REQUESTS_PER_CLIENT_PER_MINUTE=20   # per browser
# AI_REQUESTS_PER_CLIENT_PER_DAY=400
# TRUST_PROXY=1                          # trust x-forwarded-for (automatic on Vercel)
# ALLOWED_ORIGINS=                       # extra sites allowed to call the API (comma-separated)
