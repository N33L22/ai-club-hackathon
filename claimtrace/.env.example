# Copy to .env.local and fill in. Never commit .env.local.

# AI (Scout, Skeptic, Assistant). Without a key the app still works:
# references are verified by code and claims show "Unchecked", never "Verified".
NVIDIA_API_KEY=

# Any OpenAI-compatible provider works by changing these two (defaults shown).
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=meta/llama-3.3-70b-instruct
# AI_PROVIDER_LABEL=NVIDIA NIM
# AI_REQUESTS_PER_MINUTE=35
# AI_TEMPERATURE=0

# Optional: contact address for the Crossref and OpenAlex "polite pool" (faster, more reliable).
# CONTACT_EMAIL=
# OPENALEX_API_KEY=
